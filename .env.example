# Copy to .env and fill in private values on your machine or hosting account.
# Never commit the completed .env file.
SITE_URL=https://webostics.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Webostics"
CONTACT_RECEIVER_EMAIL=
CONTACT_RECEIVER_NAME="Saad Ahmad"

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_ACTION=contact_submit
RECAPTCHA_MIN_SCORE=0.5

# Optional overrides. Normally leave these empty.
# SMTP_CA_FILE is an absolute path to a host-maintained CA certificate bundle.
SMTP_CA_FILE=
# If set, this must match the hostname returned by Google reCAPTCHA.
RECAPTCHA_HOSTNAME=
